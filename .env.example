PORT=3000
# Public URL from `npm run tunnel` (cloudflared) — Relay and Cashfree call this
PUBLIC_URL=https://xxxx.trycloudflare.com

# Sarvam (credits handed out on the day) — dashboard.sarvam.ai
SARVAM_API_KEY=

# Cashfree TEST mode — merchant.cashfree.com → Switch to test → Developers → API keys
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01

# Relay agent's Inbound Webhook trigger URL (copy from the Relay canvas)
RELAY_WEBHOOK_URL=

# Samvaad Voice Agents (separate from SARVAM_API_KEY for speech/chat APIs)
SARVAM_VOICE_API_KEY=
SARVAM_VOICE_ORG_ID=01a1f4b4-85d3-76bb-8247-4a17ad46fc2a
SARVAM_VOICE_WORKSPACE_ID=01a1f4b4-85db-77ea-8738-6046012e4949
SARVAM_VOICE_APP_ID=Tamil-Payme-bc4e8ec8-8f51
# Optional committed version number; omit to use latest committed version.
SARVAM_VOICE_VERSION=
